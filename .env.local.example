# ============================================================
# Скопируй этот файл в .env.local и заполни свои значения
# cp .env.local.example .env.local
# ============================================================

# --- Supabase (добавить в Чате 2) ---
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- NextAuth (добавить в Чате 4) ---
# Генерируй через: openssl rand -base64 32
NEXTAUTH_SECRET="сгенерируй-через-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin (добавить в Чате 4) ---
ADMIN_EMAIL="твой@email.com"
# Генерируй через: node -e "const b=require('bcrypt');b.hash('пароль',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$..."

# --- Публичный URL сайта (для SEO) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Telegram (добавить в Чате 8) ---
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/твой_канал"
